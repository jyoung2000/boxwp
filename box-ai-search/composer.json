{
    "name": "boxaisearch/box-ai-search",
    "description": "WordPress plugin for Box AI semantic document search integration",
    "type": "wordpress-plugin",
    "keywords": [
        "wordpress",
        "plugin",
        "box",
        "ai",
        "search",
        "semantic-search"
    ],
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Box AI Search Team",
            "email": "team@example.com"
        }
    ],
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "wp-coding-standards/wpcs": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "BoxAISearch\\": "includes/",
            "BoxAISearch\\Admin\\": "admin/",
            "BoxAISearch\\PublicInterface\\": "public/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BoxAISearch\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpcs": "phpcs --standard=WordPress includes/ admin/ public/",
        "phpcbf": "phpcbf --standard=WordPress includes/ admin/ public/"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
